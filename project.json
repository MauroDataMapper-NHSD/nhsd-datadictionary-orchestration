{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "nhsd-datadictionary-orchestration",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    },
    "@schematics/angular:application": {
      "strict": true
    }
  },
  "sourceRoot": "src",
  "prefix": "mdm",
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-webpack:browser",
      "options": {
        "customWebpackConfig": {
          "path": "custom-webpack.config.js"
        },
        "outputPath": "dist/nhsd-datadictionary-orchestration",
        "index": "src/index.html",
        "main": "src/main.ts",
        "polyfills": "src/polyfills.ts",
        "tsConfig": "tsconfig.app.json",
        "aot": true,
        "assets": [
          "src/assets/favicon.ico",
          "src/assets",
          {
            "glob": "open-id-connect-redirect.html",
            "input": "src/static-pages",
            "output": "/redirects"
          }
        ],
        "styles": [
          "src/styles.scss"
        ],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": [
            "src/styles",
            "src/app"
          ]
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "src/environments/environment.ts",
              "with": "src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false,
          "buildOptimizer": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "browserTarget": "nhsd-datadictionary-orchestration:build",
        "port": 4201
      },
      "configurations": {
        "production": {
          "browserTarget": "nhsd-datadictionary-orchestration:build:production"
        },
        "development": {
          "browserTarget": "nhsd-datadictionary-orchestration:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "nhsd-datadictionary-orchestration:build"
      }
    },
    "test": {
      "executor": "@angular-builders/jest:run",
      "options": {}
    }
  }
}
