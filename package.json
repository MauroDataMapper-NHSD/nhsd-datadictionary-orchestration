{
  "name": "nhsd-datadictionary-orchestration",
  "version": "1.0.0-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "nx serve orchestration",
    "build": "nx build orchestration",
    "test": "nx test orchestration && nx test ui && nx test api-client",
    "test:watch": "nx test --watch",
    "test-clearCache": "nx test --clear-cache",
    "test-with-coverage": "nx test --coverage",
    "test-with-coverage-serial": "nx test --coverage --run-in-band",
    "lint": "nx lint",
    "eslint": "tsc --noEmit && eslint . --ext ts --quiet --fix",
    "eslint-report": "eslint . --ext ts --fix -f html -o eslint_report.html",
    "eslint-junit": "eslint . --ext ts -f ./node_modules/eslint-junit/index.js",
    "dist": "nx build orchestration --configuration production --output-path=dist/nhsd-datadictionary-orchestration-$npm_package_version && npm run dist-archive",
    "dist-archive": "tar zcvf dist/nhsd-datadictionary-orchestration-${npm_package_version}.tgz -C dist nhsd-datadictionary-orchestration-$npm_package_version",
    "license-check": "license-check-and-add -f license-config.json",
    "pr-checks": "npm run license-check check && npm run eslint && npm run test"
  },
  "private": true,
  "eslint-junit": {
    "suiteName": "eslint tests",
    "output": "./eslint/eslint-junit.xml"
  },
